datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// AUTH TABLES (NextAuth.js v5 / Auth.js)
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// CORE USER & ROLE
// ─────────────────────────────────────────────

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  emailVerified  DateTime?
  name           String?
  fullName       String          @default("")
  image          String?
  passwordHash   String?         // null for OAuth users
  role           UserRole        @default(USER)
  status         UserStatus      @default(ACTIVE)
  userProfile    Profile?
  profile        MedicalProfile?
  deviceTokens   DeviceToken[]
  accounts       Account[]
  sessions       Session[]
  incidents      Incident[]      @relation("UserIncidents")
  auditLogs      AuditLog[]
  accessLogs     AccessLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber    String?
  address        String?
  city           String?
  country        String?
  gender         String?
  dateOfBirth    String?
  avatarUrl      String?
  bio            String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum UserRole {
  USER
  RESPONDER
  DOCTOR
  ORGANISATION_ADMIN
  ORGANISATION_STAFF
  MEDNIRA_SUPPORT
  MEDNIRA_OPERATIONS
  MEDNIRA_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ─────────────────────────────────────────────
// MEDICAL PROFILE 
// ─────────────────────────────────────────────

model MedicalProfile {
  id             String             @id @default(uuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodType      String?
  rhFactor       String?
  dateOfBirth    String?
  organDonor     Boolean            @default(false)
  dnrStatus      Boolean            @default(false)
  emergencyNotes String?
  height         String?
  weight         String?
  insuranceInfo  String?
  
  allergies        Allergy[]
  conditions       Condition[]
  medications      Medication[]
  contacts         EmergencyContact[]
  documents        MedicalDocument[]
  labReports       LabReport[]
  vitals           Vital[]
  vaccinations     Vaccination[]
  procedures       Procedure[]
  hospitalizations Hospitalization[]
  doctors          Doctor[]
  appointments     Appointment[]
  medicalShares    MedicalShare[]

  readinessScore Int                @default(0) // 0-100 calculated score
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

enum VerificationStatus {
  SELF_REPORTED
  DOCUMENT_VERIFIED
  PROVIDER_VERIFIED
  SYSTEM_IMPORTED
  UNVERIFIED
}

enum Visibility {
  PUBLIC_EMERGENCY
  EMERGENCY_RESPONDER
  DOCTOR_ACCESS
  PRIVATE
}

// ─────────────────────────────────────────────
// ALLERGIES
// ─────────────────────────────────────────────

model Allergy {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  substance        String
  category         String         // Medication, Food, Environmental, Latex, Insect, Other
  reaction         String?
  severity         AllergySeverity
  criticality      String?
  status           String         @default("Active") // Active, Resolved, Unknown, Unconfirmed
  verificationStatus VerificationStatus @default(UNVERIFIED)
  onsetDate        DateTime?
  notes            String?
  visibility       Visibility     @default(PUBLIC_EMERGENCY)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

// ─────────────────────────────────────────────
// CONDITIONS
// ─────────────────────────────────────────────

model Condition {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conditionName    String
  clinicalDesc     String?
  diagnosisDate    DateTime?
  status           String         @default("Active") // Active, Controlled, Resolved, In Remission, Unknown, Unconfirmed
  severity         String?
  diagnosedBy      String?
  healthcareProvider String?
  hospitalClinic   String?
  notes            String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  visibility       Visibility     @default(PUBLIC_EMERGENCY)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// MEDICATIONS
// ─────────────────────────────────────────────

model Medication {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  genericName      String
  brandName        String?
  strength         String?
  dosage           String?
  route            String?
  frequency        String?
  timing           String?
  startDate        DateTime?
  endDate          DateTime?
  prescribingDoctor String?
  indication       String?
  instructions     String?
  status           String         @default("Active") // Active, Completed, Discontinued, On Hold, Unknown
  verificationStatus VerificationStatus @default(UNVERIFIED)
  visibility       Visibility     @default(PUBLIC_EMERGENCY)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// EMERGENCY CONTACTS
// ─────────────────────────────────────────────

model EmergencyContact {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name             String
  relationship     String
  phone            String
  secondaryPhone   String?
  email            String?
  priority         Int            @default(1)
  preferredContactMethod String?
  notifyOnIncident Boolean        @default(true)
  visibility       Visibility     @default(PUBLIC_EMERGENCY)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// MEDICAL DOCUMENTS & LAB REPORTS
// ─────────────────────────────────────────────

model MedicalDocument {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  documentType     String         // Lab Report, Prescription, Imaging, Discharge Summary, etc.
  title            String
  date             DateTime?
  healthcareProvider String?
  hospitalClinic   String?
  fileUrl          String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  visibility       Visibility     @default(PRIVATE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model LabReport {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  testName         String
  testCategory     String?
  result           String
  unit             String?
  referenceRange   String?
  abnormalFlag     Boolean        @default(false)
  testDate         DateTime?
  laboratory       String?
  reportFileUrl    String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  visibility       Visibility     @default(DOCTOR_ACCESS)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// VITALS & VACCINATIONS
// ─────────────────────────────────────────────

model Vital {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  vitalType        String         // Blood Pressure, Heart Rate, SpO2, Temperature, Respiratory Rate, Blood Glucose, Weight, Height, BMI
  value            String
  unit             String?
  measurementDate  DateTime
  source           String         // Manual Entry, Connected Device, Healthcare Provider, Imported Data
  visibility       Visibility     @default(PRIVATE)
  createdAt        DateTime       @default(now())
}

model Vaccination {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  vaccine          String
  doseNumber       Int?
  date             DateTime?
  manufacturer     String?
  batchNumber      String?
  administeredBy   String?
  facility         String?
  nextDose         DateTime?
  certificateUrl   String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  visibility       Visibility     @default(DOCTOR_ACCESS)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// PROCEDURES & HOSPITALIZATIONS
// ─────────────────────────────────────────────

model Procedure {
  id                 String         @id @default(uuid())
  profileId          String
  profile            MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  procedureName      String
  date               DateTime?
  hospital           String?
  doctor             String?
  reason             String?
  outcome            String?
  complications      String?
  notes              String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  visibility         Visibility     @default(DOCTOR_ACCESS)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Hospitalization {
  id                 String         @id @default(uuid())
  profileId          String
  profile            MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  hospital           String
  admissionDate      DateTime
  dischargeDate      DateTime?
  reason             String?
  diagnosis          String?
  procedures         String?
  attendingDoctor    String?
  dischargeSummaryUrl String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  visibility         Visibility     @default(DOCTOR_ACCESS)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// DOCTORS & APPOINTMENTS
// ─────────────────────────────────────────────

model Doctor {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name             String
  specialty        String?
  hospitalClinic   String?
  contact          String?
  isPrimaryDoctor  Boolean        @default(false)
  lastConsultation DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Appointment {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  doctor           String?
  hospital         String?
  date             DateTime
  reason           String?
  notes            String?
  status           String         @default("Upcoming")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// MEDICAL SHARING
// ─────────────────────────────────────────────

model MedicalShare {
  id               String         @id @default(uuid())
  profileId        String
  profile          MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sharedWithUserId String?        // If sharing with another registered user/doctor
  sharedWithName   String?
  accessLevel      String         // Full, Limited
  permissions      Json           // e.g., ["allergies", "conditions"]
  purpose          String?
  expiresAt        DateTime?
  isRevoked        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// EMERGENCY IDENTITY & DEVICE TOKENS
// ─────────────────────────────────────────────

model DeviceToken {
  id            String       @id @default(uuid())
  token         String       @unique
  label         String       @default("Emergency QR Card")
  deviceType    DeviceType   @default(QR)
  status        DeviceStatus @default(ACTIVE)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  lastScannedAt DateTime?
  incidents     Incident[]
  accessLogs    AccessLog[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum DeviceType {
  QR
  NFC
}

enum DeviceStatus {
  UNASSIGNED
  ACTIVE
  FROZEN
  REVOKED
  REPLACED
}

// ─────────────────────────────────────────────
// INCIDENTS & NOTIFICATIONS
// ─────────────────────────────────────────────

model Incident {
  id               String          @id @default(uuid())
  deviceTokenId    String?
  deviceToken      DeviceToken?    @relation(fields: [deviceTokenId], references: [id])
  userId           String
  user             User            @relation("UserIncidents", fields: [userId], references: [id])
  status           IncidentStatus  @default(CREATED)
  locationLat      Float?
  locationLng      Float?
  locationAddress  String?
  responderNote    String?
  responderContact String?
  notifications    NotificationLog[]
  events           IncidentEvent[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  resolvedAt       DateTime?
}

enum IncidentStatus {
  CREATED
  ACKNOWLEDGED
  RESPONDING
  ESCALATED
  HANDOFF
  RESOLVED
  FALSE_ALARM
  CANCELLED
}

model IncidentEvent {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  eventType   String   // CREATED, STATUS_CHANGED, NOTE_ADDED, CONTACT_NOTIFIED, etc.
  description String?
  actorId     String?  // userId of who triggered this event
  metadata    Json?
  createdAt   DateTime @default(now())
}

model NotificationLog {
  id           String             @id @default(uuid())
  incidentId   String
  incident     Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  contactId    String?
  channel      NotificationChannel
  status       NotificationStatus @default(QUEUED)
  attemptCount Int                @default(0)
  errorMsg     String?
  sentAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ─────────────────────────────────────────────
// CARDS & ORDERS
// ─────────────────────────────────────────────

model CardOrder {
  id              String      @id @default(uuid())
  userId          String
  cardType        String      @default("STANDARD") // STANDARD, PREMIUM, SILICONE
  status          CardOrderStatus @default(PENDING)
  deliveryName    String
  deliveryAddress String
  deliveryCity    String
  deliveryCountry String      @default("BD")
  trackingNumber  String?
  card            Card?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum CardOrderStatus {
  PENDING
  PAYMENT_CONFIRMED
  PRODUCED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Card {
  id            String      @id @default(uuid())
  orderId       String      @unique
  order         CardOrder   @relation(fields: [orderId], references: [id])
  userId        String
  serialNumber  String      @unique
  status        CardStatus  @default(INACTIVE)
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum CardStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
  REPLACED
  DEACTIVATED
}

// ─────────────────────────────────────────────
// SUBSCRIPTIONS & BILLING
// ─────────────────────────────────────────────

model Plan {
  id            String         @id @default(uuid())
  name          String         @unique // FREE, ESSENTIAL, PROFESSIONAL, FAMILY
  displayName   String
  price         Float          @default(0)
  currency      String         @default("BDT")
  billingPeriod String         @default("MONTHLY") // MONTHLY, YEARLY
  features      Json           // Array of feature strings
  isActive      Boolean        @default(true)
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String
  planId            String
  plan              Plan               @relation(fields: [planId], references: [id])
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean           @default(false)
  externalRef       String?            // Stripe/payment provider reference
  payments          Payment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIALING
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  amount         Float
  currency       String        @default("BDT")
  status         PaymentStatus @default(PENDING)
  externalRef    String?       // Payment provider transaction ID
  invoiceUrl     String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────
// ORGANISATIONS
// ─────────────────────────────────────────────

model Organisation {
  id           String               @id @default(uuid())
  name         String
  type         OrgType
  email        String?
  phone        String?
  address      String?
  country      String               @default("BD")
  status       OrgStatus            @default(PENDING_VERIFICATION)
  members      OrganisationMember[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

enum OrgType {
  HOSPITAL
  CLINIC
  AMBULANCE_SERVICE
  SCHOOL
  UNIVERSITY
  COMPANY
  OTHER
}

enum OrgStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

model OrganisationMember {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  role           String       @default("STAFF") // ADMIN, STAFF
  joinedAt       DateTime     @default(now())
}

// ─────────────────────────────────────────────
// VERIFICATION (Doctors & Responders)
// ─────────────────────────────────────────────

model Verification {
  id           String             @id @default(uuid())
  userId       String             @unique
  type         VerificationType
  status       VerificationStatus_Enum @default(PENDING)
  credentials  Json?              // License numbers, registrations, etc.
  reviewedBy   String?            // Admin userId
  reviewNote   String?
  submittedAt  DateTime           @default(now())
  reviewedAt   DateTime?
  updatedAt    DateTime           @updatedAt
}

enum VerificationType {
  DOCTOR
  RESPONDER
  ORGANISATION
}

enum VerificationStatus_Enum {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// ─────────────────────────────────────────────
// AUDIT & ACCESS LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. USER_CREATED, INCIDENT_STARTED, CARD_ACTIVATED
  resource   String?  // Resource type e.g. Incident, DeviceToken
  resourceId String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model AccessLog {
  id            String      @id @default(uuid())
  deviceTokenId String?
  deviceToken   DeviceToken? @relation(fields: [deviceTokenId], references: [id])
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  ip            String?
  userAgent     String?
  accessType    String      @default("QR_SCAN") // QR_SCAN, NFC_TAP, LINK_ACCESS
  createdAt     DateTime    @default(now())
}
